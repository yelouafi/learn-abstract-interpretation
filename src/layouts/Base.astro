---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { CHAPTERS, chapterUrl, url } from '../chapters';

interface Props { title: string; current?: string; description?: string }
const { title, current, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <div class="shell">
      <aside class="sidebar">
        <a class="brand" href={url()}>
          <span class="logo" aria-hidden="true">α γ</span>
          <span>Learn Abstract Interpretation</span>
        </a>
        <nav>
          <ol>
            {CHAPTERS.map((c) => (
              <li class:list={{ current: c.slug === current, soon: !c.ready }}>
                {c.ready
                  ? <a href={chapterUrl(c)}><span class="num">{c.n}</span>{c.title}</a>
                  : <span><span class="num">{c.n}</span>{c.title}<em>soon</em></span>}
              </li>
            ))}
          </ol>
          <p class="side-links"><a href={url('playground/')}>Playground</a> · <a href={url('language/')}>Tiny reference</a></p>
        </nav>
      </aside>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .shell { display: grid; grid-template-columns: 280px minmax(0, 1fr); min-height: 100vh; }
  .sidebar {
    position: sticky; top: 0; height: 100vh; overflow-y: auto;
    border-right: 1px solid var(--border); background: var(--bg-soft);
    padding: 1.4rem 1.1rem; font-family: var(--sans); font-size: 0.92rem;
  }
  .brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 650; color: var(--text); text-decoration: none; line-height: 1.25; }
  .logo {
    display: inline-grid; place-items: center; min-width: 2.6rem; height: 2.2rem; border-radius: 8px;
    background: var(--accent); color: white; font-family: var(--serif); font-style: italic; font-size: 0.95rem;
  }
  nav ol { list-style: none; padding: 0; margin: 1.4rem 0 0; }
  nav li { margin: 0.1rem 0; }
  nav li > a, nav li > span { display: flex; gap: 0.55rem; padding: 0.38rem 0.5rem; border-radius: 6px; color: var(--text); text-decoration: none; line-height: 1.35; }
  nav li > a:hover { background: var(--accent-soft); }
  nav li.current > a { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
  nav li.soon > span { color: var(--muted); }
  nav em { margin-left: auto; font-style: normal; font-size: 0.72rem; border: 1px solid var(--border); border-radius: 99px; padding: 0 0.45rem; align-self: center; }
  .num { color: var(--muted); min-width: 1.1rem; font-variant-numeric: tabular-nums; }
  .side-links { margin-top: 1.2rem; padding: 0 0.5rem; color: var(--muted); }
  main { padding: 2.2rem 2.4rem 5rem; max-width: 1180px; }

  @media (max-width: 900px) {
    .shell { grid-template-columns: minmax(0, 1fr); }
    .sidebar { position: static; height: auto; border-right: none; border-bottom: 1px solid var(--border); padding: 1rem 16px; }
    nav ol { margin-top: 0.8rem; font-size: 0.85rem; }
    nav li > a, nav li > span { padding: 0.2rem 0.3rem; }
    .side-links { margin-top: 0.6rem; padding: 0; }
    main { padding: 1.4rem 16px 4rem; }
  }
</style>
