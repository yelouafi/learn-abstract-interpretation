---
// The classic picture: reachable states, tests, a sound over-approximation, and the error zone.
interface Props { variant?: 'tests' | 'sound' | 'alarm' }
const { variant = 'sound' } = Astro.props;
const dots: [number, number][] = [[150, 120], [190, 95], [215, 150], [170, 175], [240, 115], [130, 160]];
---
<figure class="figure approx">
  <svg viewBox="0 0 520 280" role="img" aria-label="Reachable states, tests, over-approximation and error states">
    <rect class="err" x="370" y="20" width="135" height="240" rx="14" />
    <text class="err-label" x="437" y="145">error</text>
    <text class="err-label" x="437" y="165">states</text>

    {variant !== 'tests' && (
      <path class:list={['over', { alarm: variant === 'alarm' }]} d={variant === 'alarm'
        ? 'M60,135 C60,40 200,20 300,40 C400,60 410,130 395,180 C380,240 240,262 150,250 C70,240 60,200 60,135 Z'
        : 'M60,135 C60,45 190,25 270,40 C350,55 352,120 345,170 C335,235 230,258 150,248 C75,238 60,200 60,135 Z'} />
    )}

    <path class="reach" d="M95,140 C95,80 170,60 230,70 C290,80 300,120 290,160 C280,205 220,215 170,210 C120,205 95,185 95,140 Z" />
    {dots.map(([x, y]) => <circle class="dot" cx={x} cy={y} r="4.5" />)}

    {variant !== 'tests' && <text class="over-label" x="70" y="40">{variant === 'alarm' ? 'imprecise approximation' : 'sound approximation'}</text>}
    <text class="reach-label" x="195" y="232">reachable states</text>
  </svg>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .approx svg { max-width: 520px; width: 100%; height: auto; }
  .err { fill: var(--err-soft); stroke: var(--err); stroke-width: 1.5; }
  .err-label { fill: var(--err); font-family: var(--sans); font-size: 15px; text-anchor: middle; }
  .reach { fill: color-mix(in srgb, var(--accent) 22%, transparent); stroke: var(--accent); stroke-width: 2; }
  .over { fill: color-mix(in srgb, var(--insight) 10%, transparent); stroke: var(--insight); stroke-width: 2; stroke-dasharray: 7 5; }
  .over.alarm { fill: color-mix(in srgb, var(--warn) 12%, transparent); stroke: var(--warn); }
  .dot { fill: var(--text); }
  .reach-label { fill: var(--accent); font-family: var(--sans); font-size: 14px; text-anchor: middle; }
  .over-label { fill: var(--insight); font-family: var(--sans); font-size: 14px; }
</style>
